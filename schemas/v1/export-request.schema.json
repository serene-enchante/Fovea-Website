{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fovea.org/schemas/v1/export-request.schema.json",
  "title": "Fovea export request v1",
  "description": "Portable request contract for frontend and future export services.",
  "type": "object",
  "required": ["version", "datasetId", "format", "selection"],
  "properties": {
    "version": { "const": 1 },
    "datasetId": { "enum": ["circles", "eugene", "florence"] },
    "format": { "enum": ["geojson", "kml", "gpx", "pdf", "tiff"] },
    "selection": {
      "type": "object",
      "required": ["featureId"],
      "properties": {
        "featureId": { "type": ["string", "null"] },
        "zoneId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "includeBirdObservations": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
