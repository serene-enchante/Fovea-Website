{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fovea.org/schemas/v1/feedback-payload.schema.json",
  "title": "Fovea feedback submission v1",
  "type": "object",
  "required": ["title", "description", "geojson"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "geojson": {
      "type": "object",
      "required": ["type", "features"],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "geometry", "properties"],
            "properties": {
              "type": { "const": "Feature" },
              "geometry": { "oneOf": [
                { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/position" } } },
                { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "LineString" }, "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } } }, "minProperties": 2 },
                { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "Polygon" }, "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } } } } }
              ] },
              "properties": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["marker", "line", "polygon"] } }, "additionalProperties": true }
            }
          }
        }
      }
    }
  },
  "$defs": { "position": { "type": "array", "minItems": 2, "items": { "type": "number" } } }
}
